# Copy to .env and fill in locally. Never commit .env.
APP_ENV=local

# Postgres + pgvector (matches docker-compose.yml). Leave empty to use the in-memory store.
DATABASE_URL=

# Embeddings: "fake" (deterministic, offline, default) or "litellm"
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768

# Tailoring. Leave the key empty and ApplyPilot rewrites from the resume text only.
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
# Vertex AI alternative, only if you actually use it
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# auto = DeepEval judge only when a key is set. off = never.
LLM_JUDGE=auto
DAILY_LLM_CALLS=40

HTTP_TIMEOUT_S=15
HTTP_RETRIES=3
RETRIEVAL_K=5

# Optional tracing. Leave blank and nothing is sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

UPLOAD_DIR=./data/uploads
RUN_LOG_PATH=./data/run_log.jsonl
MAX_UPLOAD_MB=10
