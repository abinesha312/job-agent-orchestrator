# Copy to .env and fill in locally. Never commit .env.
APP_ENV=local

# Postgres + pgvector (matches docker-compose.yml). Leave empty to use the in-memory store.
DATABASE_URL=postgresql+psycopg://job_agent:job_agent@localhost:5432/job_agent

# Embeddings: "fake" (deterministic, offline, default) or "litellm"
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768

# LLM / Gemini via LiteLLM (only needed when EMBEDDING_BACKEND=litellm or for later phases)
GEMINI_API_KEY=
# Vertex AI alternative
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# Phase 4: job discovery
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Phase 5: email finder
APOLLO_API_KEY=

# Phase 8: tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
